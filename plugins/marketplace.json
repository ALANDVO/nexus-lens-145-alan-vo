{
  "schemaVersion": "1.0",
  "plugins": [
    {
      "name": "typescript-lsp",
      "description": "TypeScript/JavaScript language server (typescript-language-server)",
      "version": "1.0.0",
      "source": {
        "type": "git",
        "url": "https://github.com/anthropics/claude-plugins-official"
      },
      "lspServers": {
        "typescript": {
          "command": "typescript-language-server",
          "args": ["--stdio"],
          "transport": "stdio",
          "initializationOptions": {}
        }
      },
      "strict": false
    },
    {
      "name": "vue-volar-lsp",
      "description": "Vue.js language server using Volar (@vue/language-server)",
      "version": "1.0.0",
      "source": {
        "type": "git",
        "url": "https://github.com/anthropics/claude-plugins-official"
      },
      "lspServers": {
        "vue": {
          "command": "vue-language-server",
          "args": ["--stdio"],
          "transport": "stdio",
          "initializationOptions": {
            "typescript": {
              "tsdk": "node_modules/typescript/lib"
            }
          }
        }
      },
      "strict": false
    }
  ]
}
