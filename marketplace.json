      "license": "Apache-2.0",
      "keywords": ["python", "lsp"],
      "source": "plugins/pyright-lsp",
      "lspServers": {
        "pyright": {
          "command": "pyright-langserver",
          "args": ["--stdio"],
          "extensionToLanguage": {
            ".py": "python"
          },
          "transport": "stdio",
          "initializationOptions": {}
        }
      }
    },
    {
